{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "useDefineForClassFields": true,
    "esModuleInterop": true,
    "allowJs": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@ui/*": [
        "src/ui/*"
      ],
      "@editorCommon/*": [
        "src/editorCommon/*"
      ],
      "@stonlyCommons/*": [
        "src/shims/stonlyCommons/*"
      ],
      "stonly-editor/*": [
        "src/stonly-editor/*"
      ],
      "helpers/*": [
        "src/shims/stonlyCommons/helpers/*"
      ],
      "icons/*": [
        "src/commonsIcons/*"
      ],
      "resources/icons/*": [
        "src/commonsIcons/*"
      ],
      "global": [
        "src/shims/stonlyCommons/global/index.ts"
      ],
      "global/*": [
        "src/shims/stonlyCommons/global/*"
      ]
    }
  },
  "include": [
    "src"
  ]
}